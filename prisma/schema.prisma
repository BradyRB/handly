generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  CONTRATISTA
}

enum RequestStatus {
  PENDING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  REJECTED
  CANCELLED
}

enum AppointmentStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ReportStatus {
  OPEN
  CLOSED
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  passwordHash       String
  role               Role
  phone              String
  province           String
  municipality       String
  sessionVersion     Int                  @default(0)
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  clientProfile      ClientProfile?
  contractorProfile  ContractorProfile?
  publications       ServicePublication[]
  clientRequests     ServiceRequest[]     @relation("ClientRequests")
  contractorRequests ServiceRequest[]     @relation("ContractorRequests")
  messages           Message[]
  writtenReviews     Review[]             @relation("ReviewAuthor")
  receivedReviews    Review[]             @relation("ReviewContractor")
  reports            UserReport[]         @relation("ReportAuthor")
  reportsAgainst     UserReport[]         @relation("ReportTarget")

  @@index([role, deletedAt])
}

model ClientProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContractorProfile {
  userId          String @id
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String @default("")
  specialty       String @default("")
  experienceYears Int    @default(0)
  latitude        Float?
  longitude       Float?
}

model ServiceCategory {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String               @unique
  publications ServicePublication[]
}

model ServicePublication {
  id           String           @id @default(cuid())
  contractorId String
  contractor   User             @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  categoryId   String
  category     ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title        String
  description  String
  province     String
  municipality String
  basePrice    Decimal          @db.Decimal(12, 2)
  visible      Boolean          @default(true)
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  requests     ServiceRequest[]

  @@index([categoryId, province, visible, deletedAt])
  @@index([contractorId, deletedAt])
}

model ServiceRequest {
  id            String             @id @default(cuid())
  clientId      String
  client        User               @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Restrict)
  contractorId  String
  contractor    User               @relation("ContractorRequests", fields: [contractorId], references: [id], onDelete: Restrict)
  publicationId String
  publication   ServicePublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  serviceTitle  String
  description   String
  address       String
  province      String
  municipality  String
  status        RequestStatus      @default(PENDING)
  version       Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  conversation  Conversation?
  appointment   Appointment?
  payment       Payment?
  review        Review?

  @@index([clientId, status, createdAt])
  @@index([contractorId, status, createdAt])
}

model Conversation {
  id        String         @id @default(cuid())
  requestId String         @unique
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String       @db.VarChar(2000)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt, id])
}

model Appointment {
  id        String            @id @default(cuid())
  requestId String            @unique
  request   ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  address   String
  amount    Decimal           @db.Decimal(12, 2)
  status    AppointmentStatus @default(PROPOSED)
  updatedAt DateTime          @updatedAt

  @@index([startsAt, status])
}

model Payment {
  id                String         @id @default(cuid())
  requestId         String         @unique
  request           ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("DOP")
  method            PaymentMethod
  status            PaymentStatus  @default(PENDING)
  adapter           String
  providerSessionId String?        @unique
  attempt           Int            @default(0)
  paidAt            DateTime?
  updatedAt         DateTime       @updatedAt
}

model PaymentEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model Review {
  id           String         @id @default(cuid())
  requestId    String         @unique
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  authorId     String
  author       User           @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  contractorId String
  contractor   User           @relation("ReviewContractor", fields: [contractorId], references: [id], onDelete: Restrict)
  rating       Int
  comment      String         @db.VarChar(1000)
  createdAt    DateTime       @default(now())

  @@index([contractorId, createdAt])
  @@index([authorId, createdAt])
}

model UserReport {
  id        String       @id @default(cuid())
  authorId  String
  author    User         @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  targetId  String
  target    User         @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Restrict)
  reason    String       @db.VarChar(100)
  detail    String       @db.VarChar(2000)
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([authorId, status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  resourceId String
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}

model RateLimit {
  key      String   @id
  count    Int
  resetsAt DateTime

  @@index([resetsAt])
}
